# Copy to .env.local and fill in. Never commit real values.

# Mode: true = public demo with sample data, no real services
NEXT_PUBLIC_DEMO_MODE=false

# Only this Google account may sign in to the real app
ALLOWED_EMAIL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Voice transcription (free tiers)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Task parsing (text, images, PDFs)
ANTHROPIC_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
