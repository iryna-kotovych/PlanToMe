# Copy to .env.local and fill in. Never commit real values.
# In production these live in the Vercel project settings.

# Mode: true = public demo with sample data, no real services
NEXT_PUBLIC_DEMO_MODE=false

# Only this Google account may sign in to the real app (server-side only)
ALLOWED_EMAIL=

# Supabase (Project Settings → API keys). The publishable key is public by
# design; the secret key is server-side only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Calendar OAuth (server-side only). The same OAuth client as the
# Google sign-in; its redirect URIs also need <app URL>/auth/connect/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seals Google refresh tokens: 32 random bytes in base64 (openssl rand -base64 32).
# Changing it means connecting Google Calendar again.
TOKEN_ENCRYPTION_KEY=

# Voice transcription (free tiers)
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Task parsing (text, images, PDFs)
ANTHROPIC_API_KEY=

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Supabase CLI only (`supabase config push`): put these in the git-ignored
# supabase/.env.local, not here.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
